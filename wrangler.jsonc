// Cloudflare Worker config for the Strangers Coffee Kitchen Diary staff site.
// See README-deploy.md for how to deploy, rotate secrets and back up.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strangers-kitchen-diary",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so access control lives in one place.
    "run_worker_first": true
  },

  // No ids needed: on the first deploy Cloudflare creates the database and the PDF store automatically.
  // The Worker creates its own tables on first use (src/schema.ts).
  "d1_databases": [{ "binding": "DB", "database_name": "kitchen-diary" }],

  // Allergen PDFs and the daily backups (KV values can be up to 25 MB; uploads are capped at 20 MB).
  "kv_namespaces": [{ "binding": "FILES" }],

  // Live updates (src/live.ts): one Durable Object that open pages keep a WebSocket to. SQLite-backed, as the Workers
  // Free plan requires; it stores nothing.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  "vars": {
    // Write requests (saves, deletes, uploads) allowed per IP address per 15 minutes.
    "WRITE_LIMIT_PER_15_MIN": "600",
    // The staff rota's own address (src/rota.ts). Same Worker, database and accounts as the diary.
    "ROTA_HOST": "rota.staffstrangerscoffee.com",
    // The admin section's own address (src/adminView.ts, public/admin/): admins only. Same Worker and accounts.
    // Local dev and the tests turn it off (--var ADMIN_HOST:), so the section is at /admin there.
    "ADMIN_HOST": "admin.staffstrangerscoffee.com",
    // Ordering preview: existing staff sign-in, with management in Admin → Wholesale.
    "PREVIEW_HOST": "preview.staffstrangerscoffee.com",
    // Sign-in is shared across this domain and its subdomains, so one sign-in covers the diary and the rota
    // (src/auth.ts). `wrangler dev` rewrites the cookie's Domain to the local address, so local dev still works.
    "COOKIE_DOMAIN": "staffstrangerscoffee.com"
  },

  // Custom domains. staffstrangerscoffee.com must be a zone in the same Cloudflare account; on deploy,
  // Cloudflare creates the DNS records and certificates for these hostnames.
  // The site lives on the bare domain; the Worker redirects www to it (src/index.ts). The rota is on its own
  // subdomain (ROTA_HOST above). Keep the diary's route first: local dev uses the first route's hostname.
  "routes": [
    { "pattern": "staffstrangerscoffee.com", "custom_domain": true },
    { "pattern": "www.staffstrangerscoffee.com", "custom_domain": true },
    { "pattern": "rota.staffstrangerscoffee.com", "custom_domain": true },
    { "pattern": "admin.staffstrangerscoffee.com", "custom_domain": true },
    { "pattern": "preview.staffstrangerscoffee.com", "custom_domain": true }
  ],

  // Local dev rewrites requests to the route's hostname; keep them https so the Worker's
  // http-to-https redirect doesn't loop.
  "dev": { "upstream_protocol": "https" },

  // A backup of the diary every day at 03:17 UTC (src/backup.ts). Free on every plan.
  // The nightly backup; and the managers' Monday summary at 07:30 UK time (06:30 UTC in summer, 07:30 in winter: it
  // runs at both and sends only at 07:xx in London, once a week).
  "triggers": { "crons": ["17 3 * * *", "30 6,7 * * 1"] },

  "observability": { "enabled": true }
}
